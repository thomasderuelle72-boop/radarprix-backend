# Copie ce fichier en ".env" et renseigne tes vraies valeurs.
# Clé SerpApi gratuite sur https://serpapi.com (~100 requêtes/mois offertes)
SERPAPI_KEY=colle_ta_cle_serpapi_ici

# Secret utilisé pour signer les sessions utilisateur (JWT).
# Génère une valeur aléatoire longue, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=colle_un_secret_aleatoire_long_ici

PORT=3001

# Sur un hébergeur qui ne fait tourner qu'un seul service (ex: Railway sur le
# plan actuel), il n'y a pas de process séparé pour `npm run cron` : mets
# ENABLE_CRON=true pour que server.js démarre lui-même le scan périodique du
# catalogue. Laisse absent/false en local pour ne pas consommer le quota
# SerpApi à chaque `npm start`.
ENABLE_CRON=false
CRON_SCHEDULE=0 */2 * * *
CRON_BATCH_SIZE=10

# Collecte des flux gratuits/promotions (jeux offerts, codes promo). Ces
# sources ne sont pas facturées à la requête, contrairement à SerpApi : elles
# peuvent donc tourner beaucoup plus souvent que le scan catalogue.
CRON_FLUX_SCHEDULE=*/30 * * * *

# ── Détecteur D1 : promotions et codes promo ────────────────────────────
# Strackr agrège les flux d'offres de 54 réseaux d'affiliation derrière une
# seule API (~10 €/mois). C'est le point d'entrée le moins coûteux : il évite
# d'ouvrir et d'intégrer un compte chez chaque réseau. Laisse absent pour
# désactiver silencieusement la source.
STRACKR_API_ID=
STRACKR_API_KEY=

# Awin, en direct. Son Offers API expose aussi les promotions d'annonceurs
# auxquels tu n'es pas encore affilié, ce qui permet de couvrir large avant
# d'être accepté par chaque programme. Compte éditeur gratuit sur awin.com.
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# ── Détecteur D2 : gratuit ──────────────────────────────────────────────
# Aucune clé nécessaire : l'endpoint des jeux offerts d'Epic est public.

# ── Détecteur D3 : surveillance directe des fiches marchandes ───────────
# Nombre de fiches interrogées à chaque passage, et intervalle entre deux
# requêtes vers le même domaine (en ms) — pour rester courtois vis-à-vis des
# serveurs marchands.
WATCH_BATCH_SIZE=40
WATCH_DELAI_MS=1200

# Alertes email (erreurs de prix sur les favoris) via l'API Resend.
# Clé créée sur https://resend.com — laisse absent pour désactiver
# silencieusement l'envoi (utile en local/dev).
RESEND_API_KEY=colle_ta_cle_resend_ici
ALERT_FROM_EMAIL=RadarPrix <onboarding@resend.dev>

# Repli si SerpApi échoue (quota épuisé, panne) : Bright Data Browser API,
# un vrai navigateur distant piloté par Puppeteer. Laisse absent pour que
# SerpApi échoue simplement sans repli (comportement d'avant). Facturé au
# volume de données ($/Go) sur https://brightdata.fr : ne sert que de filet
# de sécurité, jamais de source par défaut (voir fetchOffers.js).
# Identifiants dans le dashboard Bright Data → zone "Browser API" → Détails
# d'accès (Hôte / Nom d'utilisateur / Mot de passe).
BRIGHT_DATA_BROWSER_HOST=brd.superproxy.io:9222
BRIGHT_DATA_BROWSER_USER=colle_ton_nom_utilisateur_ici
BRIGHT_DATA_BROWSER_PASS=colle_ton_mot_de_passe_ici

# Cadence de surveillance des fiches marchandes. C'est le réglage qui décide
# si une erreur de prix vivant vingt minutes est vue ou manquée.
CRON_WATCH_SCHEDULE=*/15 * * * *
