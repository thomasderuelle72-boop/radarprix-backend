# Copie ce fichier en ".env" et renseigne tes vraies valeurs.
#
# Ce fichier comptait auparavant une quarantaine de variables : clés SerpApi,
# Bright Data, eBay, Awin, Strackr, cadences de cron, seuils de détection.
# Toute cette machinerie a été retirée du backend — il ne va plus chercher
# d'offres nulle part. Ce qui reste tient en cinq lignes.

# Signe les sessions. OBLIGATOIRE.
# En changer déconnecte tous les membres.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=colle_un_secret_aleatoire_long_ici

PORT=3001

# Chemin du fichier SQLite. En production, il doit pointer sur le disque
# persistant de l'hébergeur (/app/data/radarprix.sqlite sur Railway) :
# ailleurs, les comptes repartent de zéro à chaque redéploiement.
# DB_PATH=data/radarprix.sqlite

# Adresse qui reçoit le rôle administrateur à l'inscription.
# ADMIN_EMAIL=

# Origines autorisées à appeler l'API, séparées par des virgules.
# CORS_ORIGINS=https://radarprix.fr,https://www.radarprix.fr
