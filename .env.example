# Copie ce fichier en ".env" et renseigne tes vraies valeurs.
# Clé SerpApi gratuite sur https://serpapi.com (~100 requêtes/mois offertes)
SERPAPI_KEY=colle_ta_cle_serpapi_ici

# Secret utilisé pour signer les sessions utilisateur (JWT).
# Génère une valeur aléatoire longue, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=colle_un_secret_aleatoire_long_ici

PORT=3001

# Sur un hébergeur qui ne fait tourner qu'un seul service (ex: Railway sur le
# plan actuel), il n'y a pas de process séparé pour `npm run cron` : mets
# ENABLE_CRON=true pour que server.js démarre lui-même le scan périodique du
# catalogue. Laisse absent/false en local pour ne pas consommer le quota
# SerpApi à chaque `npm start`.
ENABLE_CRON=false
CRON_SCHEDULE=0 */2 * * *
CRON_BATCH_SIZE=10
