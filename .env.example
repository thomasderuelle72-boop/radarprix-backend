# Copie ce fichier en ".env" et renseigne tes vraies valeurs.
# Tout ce qui n'est pas listé ici n'est lu par aucun code.

# ── Obligatoire ──
# Signe les sessions. En changer déconnecte tous les membres.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=colle_un_secret_aleatoire_long_ici

# ── Serveur ──
PORT=3001

# Chemin du fichier SQLite. En production il doit pointer sur le disque
# persistant de l'hébergeur (/app/data/radarprix.sqlite sur Railway) :
# ailleurs, les comptes repartent de zéro à chaque redéploiement.
# DB_PATH=data/radarprix.sqlite

# Adresse qui reçoit le rôle administrateur à l'inscription.
# ADMIN_EMAIL=

# Origines autorisées à appeler l'API, séparées par des virgules.
# Sans elle, la liste par défaut de src/server.js s'applique.
# CORS_ORIGINS=https://radarprix.fr,https://www.radarprix.fr

# ── Collecte ──
# Scraping SaaS. Sans cette clé, seules les cibles à flux et les pages
# lisibles en HTTP direct fonctionnent — c'est-à-dire très peu : douze
# fiches produits sondées chez les grandes enseignes françaises, une seule
# répond sans navigateur.
# FIRECRAWL_API_KEY=fc-...

# Jeton du service cron, qui déclenche POST /api/admin/scan sans compte
# administrateur (en-tête x-scan-token).
# SCAN_TOKEN=

# ── Service cron uniquement (npm run scan:distant) ──
# Racine de l'API à réveiller.
# SCAN_URL=https://radarprix-backend-production.up.railway.app
